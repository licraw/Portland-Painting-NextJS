# Google Places reviews
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=
# Optional override for the generated reviews snapshot
GOOGLE_REVIEWS_OUTPUT=src/data/google-reviews.json

# Asana task and upload integrations
ASANA_TOKEN=

# SMTP email delivery
EMAIL_USER=
EMAIL_PASS=
RECIPIENT_EMAIL=

# Mailchimp subscriptions
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# Google reCAPTCHA server verification
RECAPTCHA_SECRET_KEY=

# Project Stories admin (generate with `yarn admin:setup`)
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Supabase Project Stories CMS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
